{
  "firestore": {
    "rules": "backend/firestore.rules"
  },
  "hosting": {
    "public": "frontend/dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.exe"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
